<?xml version="1.0" encoding="utf-8"?>
<!-- إشعار اكتمال التنزيل: صورة مصغرة واحدة (عبر largeIcon من النظام) + اسم الملف + علامة صح فقط -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:padding="4dp">

    <!-- علامة الصح في الطرف -->
    <ImageView
        android:id="@+id/notification_status_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="6dp"
        android:src="@drawable/ic_green_check_circle" />

    <!-- المحتوى: اسم الملف مختصر + سطر الحالة -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/notification_status_icon"
        android:layout_centerVertical="true"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="اسم الملف"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notification_subtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="اكتمل التنزيل"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

</RelativeLayout>
